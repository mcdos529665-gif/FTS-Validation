{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "py -3.11 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "py -3.11 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_verify.py\"", "timeout": 120 }
        ]
      }
    ]
  }
}
